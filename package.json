{
  "name": "wpcoderscan",
  "version": "0.8.0",
  "description": "Security scanner for WordPress and PHP code. Finds vulnerabilities in plugins and themes before they ship. Taint analysis, SARIF, GitHub Action.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "WPCODER sp. z o.o.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpcoder23/wpcoderscan.git"
  },
  "homepage": "https://github.com/wpcoder23/wpcoderscan#readme",
  "bugs": {
    "url": "https://github.com/wpcoder23/wpcoderscan/issues"
  },
  "keywords": [
    "wordpress",
    "php",
    "security",
    "scanner",
    "sast",
    "static-analysis",
    "woocommerce",
    "vulnerability"
  ],
  "bin": {
    "wpcoderscan": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "php-parser": "^3.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
