{
  "name": "wpcoderscaner",
  "version": "0.1.0",
  "description": "WPCoderScaner - skaner bezpieczeństwa kodu WordPress i PHP. Wykrywa podatności w kodzie wtyczek, motywów i integracji, zanim trafią na produkcję.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "WPCODER sp. z o.o.",
  "keywords": [
    "wordpress",
    "php",
    "security",
    "scanner",
    "sast",
    "static-analysis",
    "woocommerce",
    "vulnerability"
  ],
  "bin": {
    "wpcoderscaner": "dist/cli.js",
    "wpcs": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "php-parser": "^3.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
